{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RaceLab",
  "version": "0.7.0",
  "identifier": "com.tahagurvardar.racelab",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RaceLab",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}

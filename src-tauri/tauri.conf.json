{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RaceLab",
  "version": "1.1.0",
  "identifier": "com.tahagurvardar.racelab",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RaceLab",
        "width": 1280,
        "height": 680,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Taha Gurvardar",
    "copyright": "Copyright (c) 2026 Taha Gurvardar",
    "category": "Utility",
    "shortDescription": "Forza Horizon 6 telemetry recorder and analyzer",
    "longDescription": "RaceLab listens for Forza Horizon 6 Data Out telemetry on 127.0.0.1:20440, records each driving session automatically, and analyzes it when the session ends.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
